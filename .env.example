# ---------------------------------------------------------------------------
# Copie para `.env.local` e ajuste. O `.env.local` NÃO é versionado.
#
#   cp .env.example .env.local
#   npx expo start -c
# ---------------------------------------------------------------------------

# URL base da API do backend (sem barra no final).
#
# Onde o app roda:
#   Web .................... http://localhost:8080
#   Simulador iOS ........... http://localhost:8080
#   Emulador Android ........ http://10.0.2.2:8080   (o AVD redireciona o loopback)
#   Celular físico .......... http://192.168.x.x:8080  (IP da sua máquina na rede)
#
# O app usa um fallback automático conforme a plataforma quando esta variável
# está ausente, mas em produção ela é obrigatória.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Timeout das requisições, em milissegundos. Padrão: 15000
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Papel enviado no cadastro (POST /usuarios). O backend exige o campo.
# Valores aceitos: ADMIN | USUARIO_LEIGO
#
# Mantenha USUARIO_LEIGO (padrão). Enviar ADMIN daqui permitiria que qualquer
# pessoa se cadastrasse como administradora, bastando editar um valor no
# cliente. Use ADMIN apenas para seed/testes, sabendo do risco.
EXPO_PUBLIC_TIPO_USUARIO_PADRAO=USUARIO_LEIGO

# Endpoint que devolve o usuário logado a partir do token.
# DEIXE VAZIO enquanto o backend não expor essa rota: chamar uma rota
# inexistente gera erro 500 no servidor a cada abertura e a cada login.
# A API atual tem apenas /usuarios, /usuarios/{id}, /auth/login e /api/senhas/*.
EXPO_PUBLIC_PROFILE_ENDPOINT=

# ---------------------------------------------------------------------------
# Aviso: variáveis com prefixo EXPO_PUBLIC_ são embutidas em texto plano no
# bundle do aplicativo. Nunca coloque chaves de API, senhas ou outros segredos
# aqui — use EAS Environment variables / EAS Secrets.
# ---------------------------------------------------------------------------
